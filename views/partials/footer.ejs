<footer class="mt-5 py-3 bg-light border-top">
        <div class="container text-center">
            <p class="text-muted mb-0">
                &copy; 2026 <strong><%= config.nama_perusahaan %></strong> - <%= config.nama_aplikasi %>
            </p>
            <small class="text-secondary">Sistem Manajemen Produksi & Payroll Tatriz</small>
        </div>
    </footer>

    <script>
        function tampilkanLoader() {
            const loader = document.getElementById('quickLoader');
            if (loader) loader.classList.add('show');
        }

        function sembunyikanLoader() {
            const loader = document.getElementById('quickLoader');
            if (loader) loader.classList.remove('show');
        }

        // 1. Sembunyikan loader saat halaman pertama kali dibuka (Full Refresh)
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(sembunyikanLoader, 100);
        });

        // 2. TRIGGER HTMX: Munculkan loader saat mulai pindah menu/submit form
        document.body.addEventListener('htmx:beforeRequest', function(evt) {
            tampilkanLoader();
            
            // Fallback pengaman: Jika koneksi lambat/putus, hilangkan paksa dalam 6 detik
            setTimeout(sembunyikanLoader, 6000);
        });

        // 3. TRIGGER HTMX: Sembunyikan loader saat halaman baru sudah selesai disuntikkan ke layar
        document.body.addEventListener('htmx:afterOnLoad', function(evt) {
            setTimeout(sembunyikanLoader, 100); // Transisi halus
            
            // (Opsional) Tutup menu mobile jika sedang terbuka saat pindah halaman
            const navbarMenu = document.getElementById('navbarMenu');
            if (navbarMenu && navbarMenu.classList.contains('show')) {
                const bsCollapse = new bootstrap.Collapse(navbarMenu, { toggle: false });
                bsCollapse.hide();
            }
        });
    </script>
</body>
</html>