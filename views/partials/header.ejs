<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config.nama_aplikasi %></title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        body { background-color: #f0f4f8; }
        
        /* --- Kustomisasi Navbar Tema Safir & Air --- */
        .navbar-custom {
            /* 1. ARAH GRADASI DIBALIK: 
               Kiri sangat gelap (#04142e) agar logo jelas. 
               Kanan biru muda jernih (#30c5d2) untuk nuansa air. */
            background: linear-gradient(to right, #04142e 0%, #0a367c 40%, #0f52ba 70%, #30c5d2 100%);
            position: relative;
            overflow: hidden; /* Mengunci efek air agar tidak tumpah keluar navbar */
            border-bottom: 2px solid rgba(48, 197, 210, 0.4);
            box-shadow: 0 4px 15px rgba(15, 82, 186, 0.2);
        }
        
        /* 2. EFEK AIR: Pantulan cahaya & Gelembung */
        .navbar-custom::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: 
                /* Pantulan cahaya dari permukaan atas */
                linear-gradient(to bottom, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 50%),
                
                /* Gelembung air transparan di sisi kanan/tengah */
                radial-gradient(circle at 85% 65%, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0.1) 2%, transparent 3%),
                radial-gradient(circle at 75% 30%, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.05) 3%, transparent 4%),
                radial-gradient(circle at 92% 20%, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.1) 1.5%, transparent 2.5%),
                radial-gradient(circle at 65% 75%, rgba(255,255,255,0.15) 0%, transparent 2%),
                radial-gradient(circle at 55% 40%, rgba(255,255,255,0.1) 0%, transparent 3%);
            z-index: 0;
            pointer-events: none; /* Agar gelembung tidak menghalangi klik menu */
        }
        
        /* Pastikan logo dan menu berada di lapisan atas (di atas gelembung) */
        .navbar-custom .container-fluid {
            position: relative;
            z-index: 1;
        }
        
        .nav-item { margin: 0 1px; } 
        
        .nav-link {
            color: #ffffff !important;
            font-size: 13.5px; 
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 5px; 
            padding: 8px 10px !important;
            transition: all 0.3s;
            border-radius: 6px;
            white-space: nowrap; 
            /* Tambahan bayangan teks agar tetap terbaca meski di area biru muda */
            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3); 
        }
        
        .nav-link:hover {
            color: #d4f8ff !important;
            background-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-1px);
            /* Efek pendaran (glow) air saat disentuh mouse */
            box-shadow: 0 2px 8px rgba(48, 197, 210, 0.3); 
        }

        /* Label PRO Elegan */
        .badge-pro {
            font-size: 0.65em;
            background: linear-gradient(135deg, #FFD700 0%, #DAA520 100%);
            color: #000;
            padding: 3px 6px;
            border-radius: 4px;
            font-weight: 800;
            letter-spacing: 0.5px;
            margin-left: 4px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            text-shadow: none; /* Hapus text-shadow untuk badge */
        }

        /* GLOBAL QUICK LOADER */
        #quickLoader {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(240, 244, 248, 0.8);
            backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
            z-index: 99999; display: flex; justify-content: center; align-items: center;
            opacity: 0; visibility: hidden; transition: opacity 0.2s ease-in-out;
        }
        #quickLoader.show { opacity: 1; visibility: visible; }

        /* Penyesuaian Khusus HP (Mobile View) */
        @media (max-width: 1199px) { 
            .navbar-nav { padding: 15px 0; }
            .nav-link { padding: 12px 15px !important; margin-bottom: 5px; font-size: 15px; }
            .btn-logout-mobile { margin-top: 10px; text-align: center; justify-content: center; }
            .navbar-collapse {
                /* Menu dropdown di HP juga disesuaikan temanya */
                background: linear-gradient(to bottom, rgba(10, 54, 124, 0.95), rgba(48, 197, 210, 0.95));
                border-radius: 0 0 15px 15px;
                padding: 0 10px;
            }
        }
    </style>
</head>
<body>

    <div id="quickLoader">
        <div class="spinner-border text-info" style="width: 3rem; height: 3rem;" role="status"></div>
    </div>
    
    <% const isPro = (user.tenantId === 1 || user.tenantId === 100 || user.tenantLevel >= 2); %>

    <nav class="navbar navbar-expand-xl navbar-dark mb-4 sticky-top navbar-custom">
        <div class="container-fluid px-3 px-xl-4">
            
             <a class="navbar-brand nav-link-load d-flex align-items-center" href="/dashboard" style="gap: 10px;">
                <img src="<%= config.logo_path %>" alt="Logo" style="height: 35px; width: auto; object-fit: contain; border-radius: 4px;">
                <span style="font-weight: 800; font-size: 16px; letter-spacing: 0.5px; color: #ffffff;"><%= config.nama_perusahaan %></span>
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu" aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">
                <ul class="navbar-nav ms-auto align-items-xl-center">
                    
                    <li class="nav-item">
                        <a class="nav-link nav-link-load" href="/dashboard">
                            <i class="bi bi-house-door"></i> Dashboard
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link nav-link-load" href="/po-data-v2">
                            <i class="bi bi-journal-text"></i> Data PO
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-load" href="/laporan-kas">
                            <i class="bi bi-cash-stack"></i> Keuangan
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-load" href="/input-kerja-admin">
                            <i class="bi bi-person-plus"></i> Input Admin
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-load" href="/daftar-produksi">
                            <i class="bi bi-list-check"></i> Log Prod
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-load" href="/input-gaji">
                            <i class="bi bi-calculator"></i> Hitung Gaji
                        </a>
                    </li>

                    <li class="nav-item">
                        <% if (isPro) { %>
                            <a class="nav-link nav-link-load" href="/admin/data-cmt">
                                <i class="bi bi-people-fill"></i> Data CMT
                            </a>
                        <% } else { %>
                            <a class="nav-link" href="javascript:void(0)" onclick="ajakUpgrade('Data CMT')">
                                <i class="bi bi-people-fill"></i> Data CMT <span class="badge-pro">PRO</span>
                            </a>
                        <% } %>
                    </li>

                    <li class="nav-item">
                        <% if (isPro) { %>
                            <a class="nav-link nav-link-load" href="/jadwal-produksi">
                                <i class="bi bi-calendar-range"></i> Jadwal
                            </a>
                        <% } else { %>
                            <a class="nav-link" href="javascript:void(0)" onclick="ajakUpgrade('Jadwal Produksi')">
                                <i class="bi bi-calendar-range"></i> Jadwal <span class="badge-pro">PRO</span>
                            </a>
                        <% } %>
                    </li>

                    <li class="nav-item">
                        <% if (isPro) { %>
                            <a class="nav-link nav-link-load" href="/performa-operator">
                                <i class="bi bi-bar-chart-line"></i> Performa
                            </a>
                        <% } else { %>
                            <a class="nav-link" href="javascript:void(0)" onclick="ajakUpgrade('Performa Operator')">
                                <i class="bi bi-bar-chart-line"></i> Performa <span class="badge-pro">PRO</span>
                            </a>
                        <% } %>
                    </li>

                    <li class="nav-item ms-xl-2 mt-2 mt-xl-0">
                        <a class="nav-link text-danger bg-danger bg-opacity-10 btn-logout-mobile px-3" href="/logout" style="border: 1px solid rgba(220, 53, 69, 0.2);">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <script>
        function ajakUpgrade(namaFitur) {
            Swal.fire({
                title: '<span style="color: #DAA520;">Fitur Premium</span>',
                html: `Fitur <b>${namaFitur}</b> saat ini terkunci untuk paket standar Anda.<br><br>Ingin meningkatkan efisiensi kerja? Upgrade ke <b>PRO</b> sekarang untuk membuka semua batas!`,
                icon: 'info',
                iconColor: '#DAA520',
                showCancelButton: true,
                confirmButtonColor: '#0f52ba', 
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-rocket-takeoff"></i> Lihat Paket Upgrade',
                cancelButtonText: 'Tutup',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Hubungi Admin!', 'Silakan hubungi tim developer untuk mengaktifkan paket PRO Anda.', 'success');
                }
            });
        }
    </script>
</body>
</html>