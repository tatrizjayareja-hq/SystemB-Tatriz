<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Setup - Tatriz System</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        :root { --primary: #2ecc71; --dark: #2c3e50; --light: #f4f7f6; --danger: #e74c3c; --warning: #f39c12; --blue: #3498db; --biru-safir: #0f52ba; --batik: #8c6239; --emas: #d4af37; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--light); margin: 0; padding: 20px; }
        .setup-container { max-width: 850px; margin: auto; }
        .card { background: white; padding: 26px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin-bottom: 20px; border: 1px solid #e1e4e8; display:none; }
        .card.active { display:block; animation: fadeUp .35s ease; }
        @keyframes fadeUp { from { opacity:0; transform: translateY(18px);} to { opacity:1; transform: translateY(0);} }
        .section-title { font-size: 17px; font-weight: 800; color: var(--dark); margin-bottom: 6px; display: flex; align-items: center; gap: 10px; }
        .section-sub { font-size: 12.5px; color: #7f8c8d; margin-bottom: 16px; line-height:1.6; }
        .progress-wizard { display:flex; gap:7px; margin-bottom:20px; }
        .progress-wizard div { flex:1; height:6px; background:#e0e0e0; border-radius:10px; transition:.3s; }
        .progress-wizard div.active { background: var(--primary); }
        .progress-wizard div.current { background: var(--biru-safir); }
        .step-badge { background: var(--biru-safir); color:white; padding:5px 12px; border-radius:20px; font-size:11px; font-weight:800; display:inline-block; }
        .step-badge.green { background: var(--primary); }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        @media(max-width:600px){ .grid-2 { grid-template-columns:1fr; } }
        .form-group { margin-bottom: 14px; }
        label { display: block; margin-bottom: 5px; font-weight: 700; color: #555; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
        input, textarea { width: 100%; padding: 11px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; font-size: 14px; }
        input:focus, textarea:focus { border-color: var(--primary); outline: none; box-shadow: 0 0 0 3px rgba(46,204,113,0.12); }
        .btn { width: 100%; padding: 13px; border: none; color: white; font-weight: bold; border-radius: 8px; cursor: pointer; text-transform: uppercase; font-size:13px; display:flex; align-items:center; justify-content:center; gap:8px; }
        .btn-primary { background: var(--biru-safir); }
        .btn-save { background: var(--dark); }
        .btn-outline { background:white; color:var(--biru-safir); border:2px solid var(--biru-safir); }
        .detail-box { border-radius:10px; padding:14px; margin:12px 0; font-size:12px; line-height:1.7; }
        .detail-box.red { background:#fdf0f0; border:1px solid #f5c6cb; color:#6b2a2a; }
        .detail-box.yellow { background:#fff8e6; border:1px solid #fde68a; color:#6b4a00; }
        .detail-box.green { background:#e8f8f5; border:1px solid #a7f3d0; color:#1a5a4a; }
        .detail-box.blue { background:#eef5ff; border:1px solid #bfdbfe; color:#1e3a8a; }
        .preview-nota-real { border: 2px solid var(--batik); outline: 2px solid var(--emas); outline-offset: -5px; background: #fffdf9; padding: 10px; border-radius: 6px; margin:12px 0; font-family: 'Georgia', serif; }
        .preview-nota-real .header-real { display:flex; align-items:center; border-bottom:2px solid var(--batik); background: linear-gradient(to right, rgba(212,175,55,0.1), rgba(140,98,57,0.05)); padding:8px; border-radius:4px; }
        .preview-nota-real .bank-box { background:#f7f1e5; border:1px dashed var(--batik); padding:6px; border-radius:4px; font-size:9px; }
        .badge-pro { background: var(--warning); color: white; font-size: 9px; padding: 2px 6px; border-radius: 4px; }
        .pro-locked-field { background: #f8f9fa !important; color: #95a5a6 !important; cursor: not-allowed !important; border-style: dashed !important; }
        .input-locked { background: #eee !important; cursor: not-allowed; color: #7f8c8d; font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th { background: #f8f9fa; padding: 10px; text-align: left; font-size: 11px; border-bottom: 2px solid #eee; color: #7f8c8d; }
        td { padding: 10px; border-bottom: 1px solid #eee; font-size: 13px; }
        #quickLoader { position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(255,255,255,0.6); backdrop-filter: blur(3px); z-index:99999; display:flex; justify-content:center; align-items:center; opacity:0; visibility:hidden; }
        #quickLoader.show { opacity:1; visibility:visible; }
        .spinner-simple { width:40px; height:40px; border:4px solid rgba(46,204,113,0.3); border-top:4px solid #27ae60; border-radius:50%; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .formula-box { background: var(--dark); color: white; border-radius:8px; padding:12px; font-family: monospace; font-size:11px; margin:10px 0; line-height:1.6; }
    </style>
</head>
<body>
<div id="quickLoader"><div class="spinner-simple"></div></div>
<% const isInternal = (user.tenantId === 1 || user.tenantId === 100); const isPro = (user.tenantLevel >= 2 || isInternal); %>
<div class="setup-container">
    <div style="margin-bottom:14px; display:flex; justify-content:space-between; align-items:center;">
        <a href="/dashboard" style="text-decoration:none; color:var(--dark); font-weight:bold;"><i class="bi bi-arrow-left"></i> Dashboard</a>
        <% if (isPro) { %><span class="badge-pro" style="background:var(--primary); padding:5px 10px; font-size:11px;">PRO</span><% } else { %><span class="badge-pro" style="padding:5px 10px; font-size:11px;">STANDAR</span><% } %>
    </div>
    <div class="progress-wizard"><div id="p1" class="current"></div><div id="p2"></div><div id="p3"></div><div id="p4"></div><div id="p5"></div><div id="p6"></div></div>

    <form action="/save-settings-all" method="POST" enctype="multipart/form-data" onsubmit="tampilkanLoader()">

        <div class="card active" id="step1">
            <span class="step-badge">LANGKAH 1 DARI 6 - NAMA TOKO</span>
            <div class="section-title"><i class="bi bi-building"></i> Nama Toko Bordir</div>
            <p class="section-sub">Muncul di header nota batik & laporan.</p>
            <div class="grid-2">
                <div class="form-group"><label>Nama Aplikasi</label><input type="text" value="Tatriz SystemB" readonly class="input-locked"></div>
                <div class="form-group"><label>Nama Perusahaan *</label><input type="text" name="nama_perusahaan" id="nama_perusahaan" value="<%= config.nama_perusahaan %>" required oninput="updateAllPreview()" placeholder="Bordir Berkah Klaten"></div>
            </div>
            <button type="button" class="btn btn-primary" onclick="nextStep(2)">LANJUT</button>
        </div>

        <div class="card" id="step2">
            <span class="step-badge">LANGKAH 2 DARI 6 - KONTAK</span>
            <div class="section-title"><i class="bi bi-telephone"></i> WA & Alamat</div>
            <div class="form-group"><label>Nomor WA Admin *</label><div style="display:flex; border:1px solid #ddd; border-radius:8px; overflow:hidden; background:#f8f9fa;"><span style="padding:11px; font-weight:bold; border-right:1px solid #ddd;">+62</span><input type="text" name="no_hp" value="<%= config.no_hp ? config.no_hp.toString().replace(/^62/, '') : '' %>" required oninput="formatNomorWA(this)" style="border:none; flex:1;"></div></div>
            <div class="form-group"><label>Alamat Workshop</label><textarea name="alamat" id="alamat" rows="2" oninput="updateAllPreview()"><%= config.alamat %></textarea></div>
            <div style="display:flex; gap:10px;"><button type="button" class="btn btn-outline" style="flex:1;" onclick="nextStep(1)">Kembali</button><button type="button" class="btn btn-primary" style="flex:2;" onclick="nextStep(3)">LANJUT LOGO</button></div>
        </div>

        <div class="card" id="step3">
            <span class="step-badge">LANGKAH 3 DARI 6 - LOGO</span>
            <div class="section-title"><i class="bi bi-image"></i> Logo Nota Batik</div>
            <p class="section-sub">Logo muncul di header nota batik asli + watermark tengah.</p>
            <div class="form-group"><label>Logo</label><div style="display:flex; gap:12px; background:#fdfdfd; padding:12px; border-radius:8px; border:1px solid #eee; align-items:center;"><div style="width:60px; height:60px; background:#fff; border:1px solid #ddd; border-radius:8px; display:flex; align-items:center; justify-content:center; overflow:hidden;"><% if (config.logo_path) { %><img src="<%= config.logo_path %>" id="logoPreview" style="width:100%; height:100%; object-fit:contain;"><% } else { %><i class="bi bi-image" id="logoIcon"></i><img id="logoPreview" style="display:none; width:100%; height:100%; object-fit:contain;"><% } %></div><div style="flex:1;"><input type="file" name="logo" accept="image/*" onchange="previewLogo(event)"><small style="font-size:10px;">JPG/PNG max 2MB.</small></div></div></div>
            <div class="preview-nota-real"><div class="header-real"><img id="logoPreviewReal" src="<%= config.logo_path || '' %>" style="width:42px; height:42px; object-fit:contain; margin-right:10px; background:white; border-radius:4px; <%= config.logo_path ? '' : 'display:none;' %>"><i id="logoIconReal" class="bi bi-image" style="font-size:24px; margin-right:10px; color:var(--batik); <%= config.logo_path ? 'display:none;' : '' %>"></i><div><div style="font-size:12px; font-weight:800; color:#4a2c11; text-transform:uppercase;" id="preview-nama-real"><%= config.nama_perusahaan || 'NAMA TOKOMU' %></div><div style="font-size:8px; color:#5a4a3e;" id="preview-alamat-real"><%= config.alamat || 'Alamat' %></div></div></div><div style="height:6px; background: repeating-linear-gradient(45deg, #8c6239, #8c6239 6px, #d4af37 6px, #d4af37 12px); margin:6px 0; border-radius:2px;"></div><div style="font-size:8px; color:#666;">Preview header nota batik asli.</div></div>
            <div style="display:flex; gap:10px;"><button type="button" class="btn btn-outline" style="flex:1;" onclick="nextStep(2)">Kembali</button><button type="button" class="btn btn-primary" style="flex:2;" onclick="nextStep(4)">REKENING</button></div>
        </div>

        <div class="card" id="step4">
            <span class="step-badge">LANGKAH 4 DARI 6 - REKENING</span>
            <div class="section-title"><i class="bi bi-bank"></i> Rekening Untuk Nota</div>
            <p class="section-sub">Otomatis tercetak di kotak <b>Info Transfer Pembayaran</b> di nota batik.</p>
            <div class="preview-nota-real"><div class="bank-box"><span id="preview-bank"><%= config.bank_nama || 'BCA' %></span>: <strong id="preview-rek"><%= config.bank_rekening || '1234567890' %></strong><br>a/n <span id="preview-an"><%= config.bank_atas_nama || 'Budi' %></span></div><div style="font-size:8px; color:#666; margin-top:4px;">Ini bagian footer nota asli (baris 358-364).</div></div>
            <div class="grid-2">
                <div class="form-group"><label>Nama Bank / E-Wallet</label><input type="text" name="bank_nama" id="bank_nama" value="<%= config.bank_nama || '' %>" placeholder="BCA / BRI / DANA" oninput="updateAllPreview()"></div>
                <div class="form-group"><label>Nomor Rekening</label><input type="text" name="bank_rekening" id="bank_rekening" value="<%= config.bank_rekening || '' %>" placeholder="1234567890" oninput="updateAllPreview()"></div>
                <div class="form-group" style="grid-column: 1 / -1;"><label>Atas Nama</label><input type="text" name="bank_atas_nama" id="bank_atas_nama" value="<%= config.bank_atas_nama || '' %>" placeholder="Budi Santoso" oninput="updateAllPreview()"></div>
            </div>
            <div style="display:flex; gap:10px;"><button type="button" class="btn btn-outline" style="flex:1;" onclick="nextStep(3)">Kembali</button><button type="button" class="btn btn-primary" style="flex:2;" onclick="nextStep(5)">FINANSIAL</button></div>
        </div>

        <div class="card" id="step5">
            <span class="step-badge">LANGKAH 5 DARI 6 - KEUANGAN (KUNCI PROFIT)</span>
            <div class="section-title"><i class="bi bi-cash-coin"></i> Uang Aman & Beban Tetap</div>
            <p class="section-sub">Ini yang menentukan <b>kapan perusahaan dianggap PROFIT & owner boleh ambil untung</b>.</p>

            <div class="grid-2">
                <div class="form-group">
                    <label>Saldo Dikunci (Uang Aman) <span class="badge-pro">PRO</span></label>
                    <% if (isPro) { %><input type="number" name="nominal_buffer" value="<%= config.nominal_buffer || 0 %>"><% } else { %><input type="number" value="<%= config.nominal_buffer || 0 %>" readonly class="pro-locked-field" onclick="ajakUpgrade('Saldo Aman')"><input type="hidden" name="nominal_buffer" value="<%= config.nominal_buffer || 0 %>"><% } %>
                    <div class="detail-box red">
                        <i class="bi bi-lock-fill"></i> <b>Apa itu Saldo Dikunci?</b><br>
                        Uang kas yang <b>Wajib ada & tidak boleh diambil</b> untuk jaga-jaga. Misal buat beli benang mendadak, servis mesin, atau talangan order.<br>
                        <b>Contoh:</b> Kamu set Rp 2.000.000. Artinya kas harus selalu sisa minimal Rp 2jt. Kalau kas tinggal Rp 2,5jt, yang bisa dipakai cuma Rp 500rb.
                    </div>
                </div>

                <div class="form-group">
                    <label>Beban Tetap Bulanan <span class="badge-pro">PRO</span></label>
                    <% if (isPro) { %><input type="number" name="beban_tetap" value="<%= config.beban_tetap || 0 %>"><% } else { %><input type="number" value="<%= config.beban_tetap || 0 %>" readonly class="pro-locked-field" onclick="ajakUpgrade('Beban Tetap')"><input type="hidden" name="beban_tetap" value="<%= config.beban_tetap || 0 %>"><% } %>
                    <div class="detail-box yellow">
                        <i class="bi bi-receipt"></i> <b>Apa itu Beban Tetap? (Definisi Tatriz)</b><br>
                        Ini <b>cicilan / beban owner yang ditanggung perusahaan</b> tiap bulan, <b>bukan</b> cuma listrik.<br>
                        <b>Contoh nyata:</b><br>
                        • Cicilan mesin bordir owner Rp 1.500.000<br>
                        • Sewa mesin tambahan Rp 800.000<br>
                        • Kontrakan workshop Rp 1.000.000<br>
                        <b>Total Beban Tetap = Rp 3.300.000</b><br><br>
                        Ini harus dibayar perusahaan tiap bulan, walau tidak ada orderan sekalipun.
                    </div>
                </div>
            </div>

            <div class="detail-box blue">
                <i class="bi bi-calculator-fill"></i> <b>RUMUS PROFIT TATRIZ - Kapan Owner Boleh Ambil Untung?</b><br><br>
                Sistem akan hitung: <b>Saldo Kunci + Beban Tetap = Ambang Batas Profit</b><br>
                <div class="formula-box">
                    Contoh setting kamu:<br>
                    Saldo Dikunci = Rp 2.000.000<br>
                    Beban Tetap = Rp 3.300.000 (cicilan mesin + sewa + kontrakan)<br>
                    ----------------------------------- +<br>
                    Ambang Batas = Rp 5.300.000<br><br>
                    Jika Kas Bulan Ini = Rp 6.000.000<br>
                    → Profit yang boleh diambil owner = Rp 700.000<br><br>
                    Jika Kas Bulan Ini = Rp 4.000.000<br>
                    → <span style="color:#fca5a5;">Perusahaan BELUM PROFIT. Owner BELUM boleh ambil untung.</span><br>
                    → Uang masih untuk nutup cicilan & jaga saldo aman.
                </div>
                <b>Jadi:</b> Kalau 2 angka ini belum tercapai, di dashboard akan tertulis perusahaan belum profit bulan itu. Owner sabar dulu, jangan ambil profit. Uang buat bayar cicilan mesin & jaga kas aman.
            </div>

            <div class="grid-2" style="margin-top:12px;">
                <div class="form-group"><label>Jam Kerja Reguler</label><input type="number" name="jam_kerja_reguler" value="<%= config.jam_kerja_reguler || 8 %>"></div>
                <div class="form-group"><label>Pembagi Lembur</label><input type="number" name="pembagi_lembur" value="<%= config.pembagi_lembur || 4 %>"></div>
            </div>

            <% if (isInternal) { %>
                <hr style="margin:12px 0; border:0; border-top:1px dashed #eee;">
                <div class="grid-2">
                    <div class="form-group"><label>Target Bonus Harian</label><input type="number" name="target_bonus" value="<%= config.target_bonus %>"></div>
                    <div class="form-group"><label>Bonus Dasar</label><input type="number" name="nominal_bonus_dasar" value="<%= config.nominal_bonus_dasar %>"></div>
                    <div class="form-group"><label>Kelipatan Omzet Bonus</label><input type="number" name="kelipatan_bonus" value="<%= config.kelipatan_bonus || 100000 %>"></div>
                    <div class="form-group"><label>Nominal per Lipatan</label><input type="number" name="nominal_bonus_lipat" value="<%= config.nominal_bonus_lipat || 5000 %>"></div>
                </div>
            <% } else { %>
                <input type="hidden" name="target_bonus" value="<%= config.target_bonus || 0 %>">
                <input type="hidden" name="nominal_bonus_dasar" value="<%= config.nominal_bonus_dasar || 0 %>">
                <input type="hidden" name="kelipatan_bonus" value="<%= config.kelipatan_bonus || 0 %>">
                <input type="hidden" name="nominal_bonus_lipat" value="<%= config.nominal_bonus_lipat || 0 %>">
            <% } %>

            <div style="display:flex; gap:10px; margin-top:10px;"><button type="button" class="btn btn-outline" style="flex:1;" onclick="nextStep(4)">Kembali</button><button type="button" class="btn btn-primary" style="flex:2;" onclick="nextStep(6)">LANJUT MESIN</button></div>
        </div>

        <div class="card" id="step6">
            <span class="step-badge green">LANGKAH 6 DARI 6 - MESIN</span>
            <div class="section-title"><i class="bi bi-cpu"></i> Mesin Bordir</div>
            <table><thead><tr><th>ID</th><th>Nama Mesin</th><th style="text-align:center;">Aksi</th></tr></thead><tbody><% machines.forEach(m => { %><tr><td>#<%= m.id %></td><td><strong><%= m.nama_mesin %></strong></td><td style="text-align:center;"><% if (isPro) { %><div style="display:flex; gap:5px; justify-content:center;"><button type="button" onclick="editMesin('<%= m.id %>','<%= m.nama_mesin %>')" style="background:var(--blue); color:white; border:none; padding:6px 12px; border-radius:6px;"><i class="bi bi-pencil"></i></button><button type="button" onclick="konfirmasiHapusMesin('<%= m.id %>')" style="background:var(--danger); color:white; border:none; padding:6px 12px; border-radius:6px;"><i class="bi bi-trash"></i></button></div><% } else { %><i class="bi bi-lock-fill"></i><% } %></td></tr><% }) %></tbody></table>
            <% if (isPro) { %><div class="form-group" style="margin-top:12px; background:#f0f8ff; padding:12px; border-radius:8px; border:1px dashed var(--blue);"><label style="color:var(--blue);">Tambah Mesin Baru</label><div style="display:flex; gap:8px;"><input type="text" id="nama_mesin_baru" placeholder="Mesin 02"><button type="button" class="btn" style="width:auto; background:var(--blue); padding:0 18px;" onclick="tambahMesin()">TAMBAH</button></div></div><% } %>
            <div style="display:flex; gap:10px; margin-top:15px;"><button type="button" class="btn btn-outline" style="flex:1;" onclick="nextStep(5)">Kembali</button><button type="submit" class="btn btn-save" style="flex:2;"><i class="bi bi-cloud-check-fill"></i> SIMPAN SEMUA</button></div>
        </div>

    </form>
</div>

<script>
function nextStep(n){ document.querySelectorAll('.card').forEach(c=>c.classList.remove('active')); document.getElementById('step'+n).classList.add('active'); document.querySelectorAll('.progress-wizard div').forEach((p,i)=>{ p.classList.remove('current'); p.classList.toggle('active', i < n-1); if(i===n-1) p.classList.add('current'); }); window.scrollTo({top:0, behavior:'smooth'}); }
function tampilkanLoader(){ document.getElementById('quickLoader').classList.add('show'); }
function updateAllPreview(){ const nama=document.getElementById('nama_perusahaan')?.value || 'NAMA TOKOMU'; const alamat=document.getElementById('alamat')?.value || ''; const bank=document.getElementById('bank_nama')?.value || 'BCA'; const rek=document.getElementById('bank_rekening')?.value || '1234567890'; const an=document.getElementById('bank_atas_nama')?.value || 'Budi'; document.getElementById('preview-nama-real') && (document.getElementById('preview-nama-real').innerText=nama); document.getElementById('preview-alamat-real') && (document.getElementById('preview-alamat-real').innerText=alamat); document.getElementById('preview-bank') && (document.getElementById('preview-bank').innerText=bank); document.getElementById('preview-rek') && (document.getElementById('preview-rek').innerText=rek); document.getElementById('preview-an') && (document.getElementById('preview-an').innerText=an); }
function previewLogo(e){ const file=e.target.files[0]; if(!file) return; const r=new FileReader(); r.onload=function(ev){ const p=document.getElementById('logoPreview'); if(p){ p.src=ev.target.result; p.style.display='block'; } const ic=document.getElementById('logoIcon'); if(ic) ic.style.display='none'; const pr=document.getElementById('logoPreviewReal'); if(pr){ pr.src=ev.target.result; pr.style.display='block'; } const icr=document.getElementById('logoIconReal'); if(icr) icr.style.display='none'; }; r.readAsDataURL(file); }
function formatNomorWA(i){ let n=i.value.replace(/\D/g,''); if(n.startsWith('0')) n=n.substring(1); if(n.startsWith('62')) n=n.substring(2); i.value=n; }
function tambahMesin(){ const nama=document.getElementById('nama_mesin_baru').value.trim(); if(!nama){ Swal.fire('Isi dulu','Nama mesin kosong','warning'); return; } tampilkanLoader(); const form=document.createElement('form'); form.method='POST'; form.action='/save-settings-all'; form.enctype='multipart/form-data'; ['nama_perusahaan','no_hp','alamat','bank_nama','bank_rekening','bank_atas_nama','nominal_buffer','beban_tetap','jam_kerja_reguler','pembagi_lembur'].forEach(name=>{ const el=document.querySelector(`[name="${name}"]`); if(el){ const h=document.createElement('input'); h.type='hidden'; h.name=name; h.value=el.value; form.appendChild(h); } }); const m=document.createElement('input'); m.type='hidden'; m.name='nama_mesin_baru'; m.value=nama; form.appendChild(m); document.body.appendChild(form); form.submit(); }
function ajakUpgrade(f){ Swal.fire({ title:'Fitur PRO!', text:f+' hanya di PRO', icon:'lock', showCancelButton:true, confirmButtonColor:'#2ecc71', confirmButtonText:'Hubungi Developer' }).then(r=>{ if(r.isConfirmed) window.open('https://wa.me/+6281315290003?text=Upgrade PRO '+f, '_blank'); }); }
function editMesin(id,nama){ Swal.fire({ title:'Edit Mesin', input:'text', inputValue:nama, showCancelButton:true }).then(r=>{ if(r.isConfirmed && r.value){ tampilkanLoader(); const form=document.createElement('form'); form.method='POST'; form.action='/save-mesin'; const i1=document.createElement('input'); i1.type='hidden'; i1.name='mesin_id'; i1.value=id; const i2=document.createElement('input'); i2.type='hidden'; i2.name='nama_mesin'; i2.value=r.value; form.appendChild(i1); form.appendChild(i2); document.body.appendChild(form); form.submit(); } }); }
function konfirmasiHapusMesin(id){ Swal.fire({ title:'Hapus mesin?', icon:'warning', showCancelButton:true, confirmButtonColor:'#e74c3c', confirmButtonText:'Ya' }).then(r=>{ if(r.isConfirmed){ tampilkanLoader(); window.location.href='/delete-mesin/'+id; } }); }
document.addEventListener('DOMContentLoaded', ()=>{ document.getElementById('quickLoader').classList.remove('show'); updateAllPreview(); });
</script>
</body>
