<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Setup - Tatriz System</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        :root {
            --primary: #2ecc71; --primary-dark: #27ae60; --dark: #2c3e50;
            --light: #f4f7f6; --danger: #e74c3c; --warning: #f39c12; --blue: #3498db;
            --biru-safir: #0f52ba;
        }
        body { font-family: 'Segoe UI', sans-serif; background: var(--light); margin: 0; padding: 20px; }
        .setup-container { max-width: 750px; margin: auto; }
        .card { background: white; padding: 28px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin-bottom: 20px; border: 1px solid #e1e4e8; display:none; position: relative; }
        .card.active { display:block; animation: fadeUp .35s ease; }
        @keyframes fadeUp { from { opacity:0; transform: translateY(18px);} to { opacity:1; transform: translateY(0);} }
        .section-title { font-size: 17px; font-weight: 800; color: var(--dark); margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
        .section-sub { font-size: 12.5px; color: #7f8c8d; margin-bottom: 18px; line-height:1.5; }
        .progress-wizard { display:flex; gap:8px; margin-bottom:22px; }
        .progress-wizard div { flex:1; height:6px; background:#e0e0e0; border-radius:10px; transition:.3s; }
        .progress-wizard div.active { background: var(--primary); }
        .progress-wizard div.current { background: var(--biru-safir); }
        .step-badge { background: var(--biru-safir); color:white; padding:5px 12px; border-radius:20px; font-size:11px; font-weight:800; letter-spacing:0.6px; display:inline-block; }
        .step-badge.green { background: var(--primary); }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        @media(max-width:600px){ .grid-2 { grid-template-columns:1fr; } }
        .form-group { margin-bottom: 16px; }
        label { display: block; margin-bottom: 6px; font-weight: 700; color: #555; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
        input, textarea, select { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; font-size: 14px; transition: 0.3s; }
        input:focus, textarea:focus { border-color: var(--primary); outline: none; box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.12); }
        .btn { width: 100%; padding: 13px; border: none; color: white; font-weight: bold; border-radius: 8px; cursor: pointer; text-transform: uppercase; transition: 0.3s; font-size:13px; display:flex; align-items:center; justify-content:center; gap:8px; }
        .btn-primary { background: var(--biru-safir); }
        .btn-primary:hover { background: #0a3d8f; }
        .btn-save { background: var(--dark); font-size: 15px; margin-top: 10px; border: 2px solid var(--dark); }
        .btn-outline { background:white; color:var(--biru-safir); border:2px solid var(--biru-safir); margin-top:10px; }
        .detail-box { background:#f0f7ff; border:1px solid #d6e4ff; border-radius:12px; padding:13px 14px; margin:14px 0; font-size:12px; color:#2c3e50; line-height:1.6; }
        .detail-box.yellow { background:#fff8e6; border-color:#fde68a; }
        .detail-box.green { background:#e8f8f5; border-color:#a7f3d0; }
        .detail-box i { margin-right:6px; }
        .preview-nota { background:white; border:1px dashed var(--biru-safir); border-radius:12px; padding:14px; margin:14px 0; }
        .preview-nota .header-nota { display:flex; align-items:center; gap:12px; border-bottom:1px solid #eee; padding-bottom:10px; margin-bottom:10px; }
        .logo-dummy { width:50px; height:50px; background:#eef2ff; border-radius:10px; display:flex; align-items:center; justify-content:center; color:var(--biru-safir); font-size:22px; border:1px dashed #c3d2ff; overflow:hidden; }
        .logo-dummy img { width:100%; height:100%; object-fit:cover; }
        .pro-locked-field { background: #f8f9fa !important; color: #95a5a6 !important; cursor: not-allowed !important; border-style: dashed !important; }
        .badge-pro { background: var(--warning); color: white; font-size: 9px; padding: 2px 6px; border-radius: 4px; vertical-align: middle; }
        table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        th { background: #f8f9fa; padding: 10px; text-align: left; font-size: 11px; border-bottom: 2px solid #eee; color: #7f8c8d; }
        td { padding: 10px; border-bottom: 1px solid #eee; font-size: 13px; }
        .input-locked { background: #eee !important; cursor: not-allowed; color: #7f8c8d; font-weight: bold; }
        #quickLoader { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.6); backdrop-filter: blur(3px); z-index: 99999; display: flex; justify-content: center; align-items: center; opacity: 0; visibility: hidden; transition: opacity 0.2s ease-in-out; }
        #quickLoader.show { opacity: 1; visibility: visible; }
        .spinner-simple { width: 40px; height: 40px; border: 4px solid rgba(46, 204, 113, 0.3); border-top: 4px solid var(--primary-dark); border-radius: 50%; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>

<div id="quickLoader"><div class="spinner-simple"></div></div>

<% 
    const isInternal = (user.tenantId === 1 || user.tenantId === 100); 
    const isPro = (user.tenantLevel >= 2 || isInternal);
%>

<div class="setup-container">
    <div style="margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center;">
        <a href="/dashboard" class="nav-link-load" style="text-decoration: none; color: var(--dark); font-weight: bold;"><i class="bi bi-arrow-left"></i> Dashboard</a>
        <% if (isPro) { %>
            <span class="badge-pro" style="font-size: 11px; padding: 5px 10px; background: var(--primary);">LISENSI: AKUN PRO</span>
        <% } else { %>
            <span class="badge-pro" style="font-size: 11px; padding: 5px 10px; background: var(--warning);">LISENSI: AKUN STANDAR</span>
        <% } %>
    </div>

    <div class="progress-wizard">
        <div id="p1" class="current"></div>
        <div id="p2"></div>
        <div id="p3"></div>
        <div id="p4"></div>
    </div>

    <form action="/save-settings-all" method="POST" enctype="multipart/form-data" onsubmit="tampilkanLoader()" id="setupForm">

        <!-- STEP 1: NAMA PERUSAHAAN -->
        <div class="card active" id="step1">
            <span class="step-badge">LANGKAH 1 DARI 4 - NAMA TOKO</span>
            <div class="section-title"><i class="bi bi-building"></i> Siapa Nama Toko Bordirmu?</div>
            <p class="section-sub">Nama ini akan muncul di <b>3 tempat penting</b>: Header aplikasi pembukuan, Nota tagihan yang dikirim via WA ke pelanggan, dan Laporan. Jadi harus jelas.</p>

            <div class="preview-nota">
                <div class="header-nota">
                    <div class="logo-dummy" id="preview-logo"><i class="bi bi-image"></i></div>
                    <div>
                        <div style="font-weight:900; color:var(--dark); font-size:14px;" id="preview-nama"><%= config.nama_perusahaan || 'Nama Tokomu' %></div>
                        <div style="font-size:11px; color:#666;" id="preview-alamat"><%= config.alamat || 'Alamatmu akan muncul di sini' %></div>
                    </div>
                </div>
                <div style="font-size:11px; color:#555;">NOTA: Pelanggan Bapak Budi - 50 Pcs Bordir Dada<br><b style="color:var(--biru-safir);">Logo + Nama toko muncul di sini biar pelanggan percaya & cepat bayar</b></div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Nama Aplikasi</label>
                    <input type="text" value="Tatriz SystemB" readonly class="input-locked">
                    <small style="font-size:10px; color:#999;">Tidak bisa diubah</small>
                </div>
                <div class="form-group">
                    <label>Nama Perusahaan / Toko *</label>
                    <input type="text" name="nama_perusahaan" id="nama_perusahaan" value="<%= config.nama_perusahaan %>" required oninput="updatePreviewNama(this.value)" placeholder="Contoh: Bordir Berkah Klaten">
                    <small style="font-size:10px; color:#666;">Contoh: Bordir Berkah, Tatriz Jayareja</small>
                </div>
            </div>

            <div class="detail-box green">
                <i class="bi bi-patch-check"></i> <b>Kenapa harus jelas?</b> Pelanggan lihat nota di WA. Kalau nama toko + logo jelas, mereka lebih percaya dan lebih cepat transfer. Nanti logo bisa di-upload di langkah 3.
            </div>

            <button type="button" class="btn btn-primary" onclick="nextStep(2)">LANJUT KE KONTAK <i class="bi bi-arrow-right"></i></button>
        </div>

        <!-- STEP 2: WA & ALAMAT -->
        <div class="card" id="step2">
            <span class="step-badge">LANGKAH 2 DARI 4 - KONTAK & ALAMAT</span>
            <div class="section-title"><i class="bi bi-telephone"></i> Kontak & Alamat Workshop</div>
            <p class="section-sub">Nomor WA ini untuk <b>3 hal</b>: Terima pengingat masa aktif sistem, Verifikasi login, dan Jadi nomor pengirim nota (kalau pakai WA Gateway nanti).</p>

            <div class="form-group">
                <label>Nomor WA Admin (Untuk Tagihan & Pengingat) *</label>
                <div style="display: flex; align-items: center; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; background: #f8f9fa;">
                    <span style="padding: 12px; font-weight: bold; color: #555; border-right: 1px solid #ddd;">+62</span>
                    <input type="text" name="no_hp" id="no_hp" value="<%= config.no_hp ? config.no_hp.toString().replace(/^62/, '') : '' %>" required oninput="formatNomorWA(this); updatePreviewWA(this.value)" style="border: none; border-radius: 0; flex: 1;" placeholder="8131529xxxx">
                </div>
                <small style="font-size: 10px; color: #e74c3c; margin-top: 5px; display: block;">*Wajib. Nomor ini akan menerima WA pengingat masa aktif sistem & jatuh tempo.</small>
            </div>

            <div class="form-group">
                <label>Alamat Workshop *</label>
                <textarea name="alamat" id="alamat" rows="3" placeholder="Contoh: Sraten RT 05 RW 02, Pedan, Klaten, Jawa Tengah" oninput="updatePreviewAlamat(this.value)"><%= config.alamat %></textarea>
                <small style="font-size:10px; color:#666;">Alamat ini tercetak di bawah nama toko di nota WA. Tulis lengkap biar pelanggan tahu lokasi workshop.</small>
            </div>

            <div class="detail-box">
                <i class="bi bi-shield-check"></i> <b>Untuk nota & header:</b><br>
                - Nama perusahaan = Header dashboard & nota<br>
                - WA & Alamat = Footer nota & pengingat sistem<br>
                - Logo = Langkah selanjutnya
            </div>

            <div style="display:flex; gap:10px;">
                <button type="button" class="btn btn-outline" style="flex:1;" onclick="nextStep(1)"><i class="bi bi-arrow-left"></i> Kembali</button>
                <button type="button" class="btn btn-primary" style="flex:2;" onclick="nextStep(3)">LANJUT KE LOGO <i class="bi bi-arrow-right"></i></button>
            </div>
        </div>

        <!-- STEP 3: LOGO -->
        <div class="card" id="step3">
            <span class="step-badge">LANGKAH 3 DARI 4 - LOGO TOKO</span>
            <div class="section-title"><i class="bi bi-image"></i> Logo Untuk Nota & Header</div>
            <p class="section-sub"><b>Ini paling penting untuk kepercayaan pelanggan!</b> Logo akan muncul di 2 tempat: Pojok kiri header aplikasi pembukuan, dan pojok kiri atas nota tagihan yang dikirim via WA.</p>

            <div class="form-group">
                <label>Logo Perusahaan / Nota</label>
                <div style="display: flex; align-items: center; gap: 15px; background: #fdfdfd; padding: 14px; border-radius: 10px; border: 1px solid #eee;">
                    <div class="logo-dummy" style="width:70px; height:70px;">
                        <% if (config.logo_url) { %>
                            <img src="<%= config.logo_url %>" id="logoPreview" style="width:100%; height:100%; object-fit:cover;">
                        <% } else { %>
                            <i class="bi bi-image" id="logoIcon" style="font-size:28px;"></i>
                            <img id="logoPreview" style="display:none; width:100%; height:100%; object-fit:cover;">
                        <% } %>
                    </div>
                    <div style="flex:1;">
                        <input type="file" name="logo" id="logoInput" accept="image/*" onchange="previewLogo(event)">
                        <small style="font-size:10px; color:#666; display:block; margin-top:6px;">
                            Format: JPG/PNG, max 2MB. Kalau tidak ada logo, bisa pakai foto workshop atau kosongkan dulu.<br>
                            <b>Logo ini akan muncul di:</b> Header dashboard (atas kiri) & Nota WA pelanggan.
                        </small>
                    </div>
                </div>
            </div>

            <div class="preview-nota">
                <div class="header-nota">
                    <div class="logo-dummy"><img id="logoPreview2" style="display:none; width:100%; height:100%; object-fit:cover;"><i class="bi bi-image" id="logoIcon2"></i></div>
                    <div>
                        <div style="font-weight:900; color:var(--dark); font-size:14px;" id="preview-nama-2"><%= config.nama_perusahaan || 'Nama Tokomu' %></div>
                        <div style="font-size:11px; color:#666;">Logo + Nama + Alamat muncul di sini</div>
                    </div>
                </div>
                <div style="font-size:11px; color:#555;">Ini contoh nota yang diterima pelanggan di WA. Dengan logo, nota terlihat profesional & terpercaya.</div>
            </div>

            <div class="detail-box yellow">
                <i class="bi bi-lightbulb"></i> <b>Tips logo:</b> Pakai logo kotak, background putih/transparan, tulisan jelas. Kalau belum punya logo, foto depan workshop atau tulisan nama toko juga boleh. Bisa diubah kapan saja di sini.
            </div>

            <div style="display:flex; gap:10px;">
                <button type="button" class="btn btn-outline" style="flex:1;" onclick="nextStep(2)"><i class="bi bi-arrow-left"></i> Kembali</button>
                <button type="button" class="btn btn-primary" style="flex:2;" onclick="nextStep(4)">LANJUT KE MESIN <i class="bi bi-arrow-right"></i></button>
            </div>
        </div>

        <!-- STEP 4: MANAJEMEN MESIN -->
        <div class="card" id="step4">
            <span class="step-badge green">LANGKAH 4 DARI 4 - MESIN BORDIR</span>
            <div class="section-title"><i class="bi bi-cpu"></i> Mesin Bordir Aktif</div>
            <p class="section-sub">Daarkan mesin yang kamu punya. Operator nanti absen & input hasil kerja berdasarkan mesin ini.</p>

            <% if (!isPro) { %>
                <div style="background:#fff3cd; border:1px solid #fde68a; padding:12px; border-radius:8px; margin-bottom:15px; font-size:12px; color:#7a5a00;">
                    <i class="bi bi-lock-fill"></i> Akun Standar terbatas 1 Mesin aktif. <b>Upgrade PRO</b> untuk menambah unit mesin (Portable/Cabang).
                </div>
            <% } else { %>
                <div class="form-group" style="background: #f0f8ff; padding: 15px; border-radius: 8px; border: 1px dashed var(--blue);">
                    <label style="color: var(--blue);"><i class="bi bi-plus-circle-fill"></i> Tambah Mesin Baru</label>
                    <div style="display: flex; gap: 10px;">
                        <input type="text" name="nama_mesin_baru" id="nama_mesin_baru" placeholder="Contoh: Mesin 02 - Portable" style="flex: 1; border-color: #b9d7f1;">
                        <button type="button" class="btn" style="width: auto; background: var(--blue); padding: 0 20px;" onclick="tambahMesin()">
                            TAMBAH
                        </button>
                    </div>
                    <small style="color: #555; font-size: 10px; margin-top: 5px; display: block;">*Ketik nama mesin lalu klik tambah. Nanti operator pilih mesin ini saat input kerja.</small>
                </div>
            <% } %>

            <table>
                <thead>
                    <tr>
                        <th style="width: 50px;">ID</th>
                        <th>Nama Mesin Aktif</th>
                        <th style="text-align: center; width: 150px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% machines.forEach(m => { %>
                    <tr>
                        <td style="color: #95a5a6;">#<%= m.id %></td>
                        <td><strong><%= m.nama_mesin %></strong></td>
                        <td style="text-align: center;">
                            <% if (isPro) { %>
                                <div style="display: flex; gap: 5px; justify-content: center;">
                                    <button type="button" onclick="editMesin('<%= m.id %>', '<%= m.nama_mesin %>')" style="background: var(--blue); color: white; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 11px;"><i class="bi bi-pencil"></i></button>
                                    <button type="button" onclick="konfirmasiHapusMesin('<%= m.id %>')" style="background: var(--danger); color: white; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 11px;"><i class="bi bi-trash"></i></button>
                                </div>
                            <% } else { %>
                                <i class="bi bi-lock-fill text-muted" onclick="ajakUpgrade('Manajemen Mesin')"></i>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>

            <div class="detail-box green" style="margin-top:15px;">
                <i class="bi bi-info-circle"></i> <b>Untuk apa mesin?</b> Saat operator input hasil kerja di HP, dia pilih mesin mana yang dipakai. Jadi kamu bisa tau produktivitas per mesin. Kalau cuma 1 mesin, pakai "Mesin Utama" saja cukup.
            </div>

            <div style="display:flex; gap:10px; margin-top:15px;">
                <button type="button" class="btn btn-outline" style="flex:1;" onclick="nextStep(3)"><i class="bi bi-arrow-left"></i> Kembali</button>
                <button type="submit" class="btn btn-save" style="flex:2;"><i class="bi bi-cloud-check-fill"></i> SIMPAN SEMUA PERUBAHAN</button>
            </div>
        </div>

    </form>
</div>

<script>
    let currentStep = 1;
    function nextStep(n){
        document.querySelectorAll('.card').forEach(c=>c.classList.remove('active'));
        document.getElementById('step'+n).classList.add('active');
        document.querySelectorAll('.progress-wizard div').forEach((p,i)=>{ 
            p.classList.remove('current'); 
            p.classList.toggle('active', i < n-1); 
            if(i === n-1) p.classList.add('current');
        });
        currentStep = n;
        window.scrollTo({top:0, behavior:'smooth'});
    }

    function tampilkanLoader(){
        const loader = document.getElementById('quickLoader');
        if(loader) loader.classList.add('show');
    }

    document.addEventListener('DOMContentLoaded', () => {
        const loader = document.getElementById('quickLoader');
        if(loader) loader.classList.remove('show');
        document.querySelectorAll('.nav-link-load').forEach(link=>{
            link.addEventListener('click', function(){ tampilkanLoader(); });
        });
    });

    function updatePreviewNama(val){
        document.getElementById('preview-nama').innerText = val || 'Nama Tokomu';
        const el2 = document.getElementById('preview-nama-2');
        if(el2) el2.innerText = val || 'Nama Tokomu';
    }
    function updatePreviewAlamat(val){
        const el = document.getElementById('preview-alamat');
        if(el) el.innerText = val || 'Alamatmu akan muncul di sini';
    }
    function updatePreviewWA(val){
        // bisa dipakai untuk preview
    }
    function previewLogo(event){
        const file = event.target.files[0];
        if(file){
            const reader = new FileReader();
            reader.onload = function(e){
                document.getElementById('logoPreview').src = e.target.result;
                document.getElementById('logoPreview').style.display='block';
                const icon = document.getElementById('logoIcon');
                if(icon) icon.style.display='none';
                const preview2 = document.getElementById('logoPreview2');
                const icon2 = document.getElementById('logoIcon2');
                if(preview2){ preview2.src = e.target.result; preview2.style.display='block'; }
                if(icon2){ icon2.style.display='none'; }
                const dummy = document.getElementById('preview-logo');
                if(dummy){
                    dummy.innerHTML = `<img src="${e.target.result}" style="width:100%; height:100%; object-fit:cover; border-radius:8px;">`;
                }
            }
            reader.readAsDataURL(file);
        }
    }
    function formatNomorWA(input){
        let nomor = input.value.replace(/\D/g, '');
        if(nomor.startsWith('0')) nomor = nomor.substring(1);
        if(nomor.startsWith('62')) nomor = nomor.substring(2);
        input.value = nomor;
    }
    function tambahMesin(){
        const nama = document.getElementById('nama_mesin_baru').value.trim();
        if(!nama){ Swal.fire('Isi dulu', 'Nama mesin tidak boleh kosong', 'warning'); return; }
        tampilkanLoader();
        const form = document.createElement('form');
        form.method='POST'; form.action='/save-settings-all';
        form.enctype='multipart/form-data';
        // Kita pakai form utama saja, tapi untuk UX cepat kita submit via form terpisah
        const input = document.createElement('input'); input.type='hidden'; input.name='nama_mesin_baru'; input.value=nama;
        // copy other required fields
        const namaPerusahaan = document.getElementById('nama_perusahaan').value;
        const noHp = document.getElementById('no_hp').value;
        const alamat = document.getElementById('alamat').value;
        const f1 = document.createElement('input'); f1.type='hidden'; f1.name='nama_perusahaan'; f1.value=namaPerusahaan;
        const f2 = document.createElement('input'); f2.type='hidden'; f2.name='no_hp'; f2.value=noHp;
        const f3 = document.createElement('input'); f3.type='hidden'; f3.name='alamat'; f3.value=alamat;
        form.appendChild(input); form.appendChild(f1); form.appendChild(f2); form.appendChild(f3);
        document.body.appendChild(form); form.submit();
    }
    function ajakUpgrade(fitur){
        Swal.fire({
            title: 'Fitur PRO!',
            text: 'Pengaturan ' + fitur + ' hanya tersedia di paket PRO',
            icon: 'lock',
            showCancelButton: true,
            confirmButtonColor: '#2ecc71',
            confirmButtonText: 'Hubungi Developer',
            cancelButtonText: 'Nanti Dulu'
        }).then((result)=>{
            if(result.isConfirmed){
                window.open('https://wa.me/+6281315290003?text=Halo%20Admin%20Tatriz,%20saya%20tertarik%20upgrade%20PRO%20terkait%20fitur%20' + fitur, '_blank');
            }
        });
    }
    function editMesin(id, namaLama){
        Swal.fire({
            title: 'Edit Nama Mesin',
            input: 'text',
            inputValue: namaLama,
            showCancelButton: true,
            confirmButtonText: 'Simpan',
        }).then((result)=>{
            if(result.isConfirmed && result.value){
                tampilkanLoader();
                const form = document.createElement('form');
                form.method='POST'; form.action='/save-mesin';
                const i1=document.createElement('input'); i1.type='hidden'; i1.name='mesin_id'; i1.value=id;
                const i2=document.createElement('input'); i2.type='hidden'; i2.name='nama_mesin'; i2.value=result.value;
                form.appendChild(i1); form.appendChild(i2);
                document.body.appendChild(form); form.submit();
            }
        });
    }
    function konfirmasiHapusMesin(id){
        Swal.fire({
            title: 'Hapus mesin?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#e74c3c',
            confirmButtonText: 'Ya, Hapus!'
        }).then((result)=>{
            if(result.isConfirmed){ 
                tampilkanLoader();
                window.location.href='/delete-mesin/'+id; 
            }
        });
    }
</script>
</body>
</html>
