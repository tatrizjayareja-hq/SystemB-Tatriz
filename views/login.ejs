<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Tatriz SystemB (Edisi Safir)</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0f52ba">
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js')
            .then(reg => console.log('PWA Tatriz Berhasil Aktif!', reg.scope))
            .catch(err => console.error('PWA Tatriz Gagal:', err));
        });
      }
    </script>
    <style>
        :root {
            --biru-safir: #0f52ba;
            --biru-gelap: #082d66;
            --biru-muda: #4e8df5;
            --putih-bg: #f0f4f8;
            --putih-utama: #ffffff;
            --teks-abu: #636e72;
        }
        body, html {
            margin: 0; padding: 0; min-height: 100vh;
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: var(--putih-bg);
            background-image: 
                radial-gradient(circle at 15% 25%, transparent 0%, transparent 15%, rgba(15, 82, 186, 0.05) 15.5%, rgba(15, 82, 186, 0.05) 16%, transparent 16.5%),
                radial-gradient(circle at 15% 25%, transparent 0%, transparent 8%, rgba(15, 82, 186, 0.08) 8.5%, rgba(15, 82, 186, 0.08) 9%, transparent 9.5%),
                radial-gradient(circle at 85% 70%, transparent 0%, transparent 20%, rgba(15, 82, 186, 0.04) 20.5%, rgba(15, 82, 186, 0.04) 21%, transparent 21.5%),
                radial-gradient(circle at 85% 70%, transparent 0%, transparent 12%, rgba(15, 82, 186, 0.06) 12.5%, rgba(15, 82, 186, 0.06) 13%, transparent 13.5%),
                radial-gradient(150% 80% at 50% 120%, var(--biru-safir) 0%, var(--biru-gelap) 40%, transparent 40.5%);
            display: flex; justify-content: center; align-items: center;
            background-repeat: no-repeat; background-size: cover;
        }
        .login-container { width: 450px; max-width: 90%; margin: 20px auto; position: relative; z-index: 10; }
        .login-card {
            background: white; border-radius: 20px; overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1), 0 5px 15px rgba(15, 82, 186, 0.15);
            display: flex; flex-direction: column; border: 1px solid rgba(15, 82, 186, 0.1);
        }
        .card-header { background: white; padding: 40px 30px 20px; text-align: center; position: relative; }
        .card-header::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 6px; background: linear-gradient(135deg, var(--biru-safir) 50%, var(--biru-muda) 50%); }
        .card-header img { width: 120px; height: auto; margin-bottom: 15px; }
        .card-header h1 { color: var(--biru-gelap); margin: 0; font-size: 26px; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; }
        .card-header .tagline { color: var(--teks-abu); font-size: 14px; margin-top: 8px; line-height: 1.4; }
        .card-body { background: linear-gradient(135deg, #ffffff 0%, #f4f8fc 100%); color: #333; padding: 40px 35px; position: relative; border-top: 1px dashed rgba(15, 82, 186, 0.2); }
        .card-body h2 { margin: 0 0 5px 0; font-size: 22px; text-align: center; color: var(--biru-safir); text-transform: uppercase; letter-spacing: 2px; font-weight: 800; }
        .card-body p { font-size: 13px; margin-bottom: 25px; text-align: center; color: var(--teks-abu); }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: 11px; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px; color: var(--biru-gelap); font-weight: bold; }
        .input-wrapper { position: relative; }
        .input-wrapper i { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--biru-safir); opacity: 0.8; }
        .input-wrapper input { width: 100%; padding: 14px 15px 14px 45px; background: var(--putih-utama); border: 1px solid rgba(15, 82, 186, 0.3); border-radius: 10px; color: #333; box-sizing: border-box; outline: none; }
        .btn-login { width: 100%; padding: 14px; background: var(--biru-safir); color: white; border: none; border-radius: 10px; font-weight: bold; font-size: 15px; cursor: pointer; margin-top: 15px; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px; }
        .btn-login:hover { background: var(--biru-gelap); }
        .forgot-password-link { text-align: right; margin-top: 8px; }
        .forgot-password-link a { font-size: 12px; color: var(--biru-safir); text-decoration: none; font-weight: 600; }
        .card-footer { background: #f8f9fa; padding: 18px; text-align: center; font-size: 13px; color: #555; border-top: 1px solid #eee; }
        .card-footer a { color: var(--biru-safir); font-weight: 800; text-decoration: none; }
        .card-footer a:hover { text-decoration: underline; }
        .setup-info { background: rgba(15,82,186,0.08); border: 1px dashed var(--biru-safir); padding: 12px; border-radius: 8px; margin-top: 20px; font-size: 12px; text-align: center; }
        #loaderSistem { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.9); z-index: 9999; display: flex; justify-content: center; align-items: center; transition: 0.3s; }
        .loader-hilang { opacity: 0 !important; visibility: hidden !important; }
    </style>
</head>
<body>
<div id="loaderSistem"><div style="width:40px; height:40px; border:4px solid rgba(15,82,186,0.2); border-top:4px solid var(--biru-safir); border-radius:50%; animation:spin 1s linear infinite;"></div></div>

    <div class="login-container">
        <div class="login-card">
            <div class="card-header">
                <img src="/img/Tatriz SystemB.png" alt="Logo Tatriz SystemB">
                <h1>Tatriz SystemB</h1>
                <p class="tagline">Solusi digital cerdas untuk manajemen bordir profesional.</p>
            </div>

            <div class="card-body">
                <h2>Portal Masuk</h2>
                <p>Silakan masuk ke akun manajemen Anda</p>

                <form action="/login" method="POST">
                    <div class="form-group">
                        <label>Username</label>
                        <div class="input-wrapper">
                            <i class="fas fa-user"></i>
                            <input type="text" name="username" placeholder="Username" required>
                        </div>
                    </div>
                    <div class="form-group" style="margin-bottom: 5px;">
                        <label>Password</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="password" placeholder="Password" required>
                        </div>
                    </div>
                    
                    <div class="forgot-password-link">
                        <a href="#" onclick="pemicuLupaPassword()">Lupa Password?</a>
                    </div>

                    <button type="submit" class="btn-login"><i class="fas fa-sign-in-alt"></i> Masuk Sekarang</button>
                </form>
                
                <div id="areaInstalPWA" style="display: none; margin-top: 20px; padding: 15px; background: rgba(15,82,186,0.05); border: 1px dashed rgba(15,82,186,0.3); border-radius: 10px; text-align: center;">
                    <p style="margin: 0 0 10px 0; font-size: 13px; color: var(--biru-gelap); opacity: 0.9;">
                        <i class="fas fa-mobile-alt" style="color: var(--biru-safir);"></i> Akses lebih cepat! Instal versi HP.
                    </p>
                    <button id="btnInstalPWA" class="btn-login" style="background: white; color: var(--biru-safir); border: 1px solid var(--biru-safir); margin-top: 0; box-shadow: none;">
                        <i class="fas fa-download"></i> INSTAL APLIKASI
                    </button>
                </div>

                <% if (isNew) { %>
                <div class="setup-info">
                    <i class="fas fa-cog"></i> Sistem baru siap dikonfigurasi. 
                    <a href="/daftar-baru" style="color: var(--biru-safir); text-decoration: underline; font-weight: bold;">Klik Daftar Baru</a>
                </div>
                <% } %>
            </div>

            <div class="card-footer">
                Belum punya akun? <a href="/daftar-baru"><i class="bi bi-rocket"></i> Daftar Perusahaan Baru</a><br>
                <small style="font-size:11px; color:#888; margin-top:5px; display:block;">Daftar dulu, admin akan aktifkan via WA</small>
            </div>
        </div>
    </div>

    <script>
        // === NOTIFIKASI ERROR DARI URL ?error= ===
        document.addEventListener('DOMContentLoaded', function(){
            const params = new URLSearchParams(window.location.search);
            const error = params.get('error');
            const reason = params.get('reason'); // tambahan: payment / pending

            if(error === 'suspended'){
                // Bedakan 2 kriteria
                if(reason === 'payment' || !reason){
                    Swal.fire({
                        title: 'Akun Ditangguhkan',
                        html: `
                            <div style="text-align:left; font-size:14px; line-height:1.6;">
                                <p>Akun Anda saat ini <b>nonaktif</b> karena:</p>
                                <ul style="margin:10px 0; padding-left:20px;">
                                    <li>Tagihan bulanan belum dibayar (lewat jatuh tempo)</li>
                                    <li>Atau masa aktif habis</li>
                                </ul>
                                <p style="background:#fff3cd; padding:10px; border-radius:8px; border:1px dashed #f39c12; font-size:12px;">
                                    Silakan hubungi Admin untuk perpanjangan. Setelah dibayar, akun akan diaktifkan lagi otomatis.
                                </p>
                            </div>
                        `,
                        icon: 'warning',
                        confirmButtonColor: '#0f52ba',
                        confirmButtonText: 'Hubungi Admin via WA',
                        showCancelButton: true,
                        cancelButtonText: 'Tutup'
                    }).then((result)=>{
                        if(result.isConfirmed){
                            const pesan = `Halo Admin Tatriz, akun saya ter-suspend karena tagihan. Username: *${params.get('u') || ''}* Mohon info pembayaran.`;
                            window.open(`https://api.whatsapp.com/send/?phone=6281315290003&text=${encodeURIComponent(pesan)}`, '_blank');
                        }
                    });
                } else if(reason === 'pending'){
                    Swal.fire({
                        title: 'Menunggu Aktivasi',
                        html: `
                            <div style="text-align:left; font-size:14px; line-height:1.6;">
                                <p>Akun Anda <b>sudah terdaftar</b>, tapi masih <b>menunggu aktivasi</b> dari admin.</p>
                                <p style="background:#d1ecf1; padding:10px; border-radius:8px; border:1px dashed #0f52ba; font-size:12px;">
                                    <b>Flow baru:</b><br>
                                    1. Anda daftar di /daftar-baru<br>
                                    2. Data masuk sebagai pending di Master Users<br>
                                    3. Admin klik Aktifkan<br>
                                    4. Baru bisa login
                                </p>
                                <p>Kalau sudah daftar, silakan WA admin biar segera diaktifkan.</p>
                            </div>
                        `,
                        icon: 'info',
                        confirmButtonColor: '#0f52ba',
                        confirmButtonText: 'WA Admin untuk Aktivasi',
                        showCancelButton: true,
                        cancelButtonText: 'Tutup'
                    }).then((result)=>{
                        if(result.isConfirmed){
                            const pesan = `Halo Admin Tatriz, saya baru daftar di /daftar-baru. Username: *${params.get('u') || ''}* Mohon diaktifkan.`;
                            window.open(`https://api.whatsapp.com/send/?phone=6281315290003&text=${encodeURIComponent(pesan)}`, '_blank');
                        }
                    });
                }
            } else if(error === 'invalid_credentials'){
                Swal.fire({ title: 'Login Gagal', text: 'Username atau password salah', icon: 'error', confirmButtonColor: '#0f52ba' });
            } else if(error === 'locked'){
                Swal.fire({ title: 'Terkunci', text: 'Akun terkunci 15 menit karena 5x salah password', icon: 'warning', confirmButtonColor: '#0f52ba' });
            }
        });

        function pemicuLupaPassword() {
        Swal.fire({
            title: 'Lupa Password?',
            html: `<p style="font-size: 14px;">Masukkan <b>Username</b> atau <b>Nama Toko</b> Anda agar kami bisa mencarinya.</p>`,
            input: 'text',
            inputPlaceholder: 'Ketik username / nama toko...',
            showCancelButton: true,
            confirmButtonColor: '#0f52ba', 
            confirmButtonText: '<i class="fab fa-whatsapp"></i> Hubungi Developer',
            cancelButtonText: 'Batal'
        }).then((result) => {
            if (result.isConfirmed && result.value) {
                const pesan = `Halo Developer Tatriz, saya lupa password login untuk akun saya (Username/Toko: *${result.value}*). Mohon bantuannya untuk reset password sementara.`;
                const noWA = '6281315290003';
                window.open(`https://api.whatsapp.com/send/?phone=${noWA}&text=${encodeURIComponent(pesan)}`, '_blank');
            }
        });
    }
   let pemicuInstal;
const areaInstal = document.getElementById('areaInstalPWA');
const btnInstal = document.getElementById('btnInstalPWA');
const isAppInstalled = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
if (!isAppInstalled) { areaInstal.style.display = 'block'; }
window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); pemicuInstal = e; areaInstal.style.display = 'block'; });
btnInstal.addEventListener('click', async () => {
    if (pemicuInstal) {
        pemicuInstal.prompt();
        const { outcome } = await pemicuInstal.userChoice;
        if (outcome === 'accepted') { console.log('User menginstal PWA'); }
        pemicuInstal = null; 
    } else {
        Swal.fire({
            title: 'Cara Instal Aplikasi',
            html: `<div style="text-align: left; font-size: 14px;"><b>Untuk Desktop (Chrome/Edge):</b><br>Klik ikon <i class="fas fa-download"></i> di pojok kanan atas URL.<br><br><b>Untuk iPhone/iOS (Safari):</b><br>Klik <b>Bagikan</b> <i class="fas fa-share-square"></i> lalu pilih <b>"Tambahkan ke Layar Utama"</b>.</div>`,
            icon: 'info', confirmButtonColor: '#0f52ba' 
        });
    }
});
window.addEventListener('appinstalled', () => { areaInstal.style.display = 'none'; });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loader = document.getElementById('loaderSistem');
            if (loader) { setTimeout(function() { loader.classList.add('loader-hilang'); }, 200); }
        });
        setTimeout(function() {
            const loader = document.getElementById('loaderSistem');
            if (loader && !loader.classList.contains('loader-hilang')) { loader.classList.add('loader-hilang'); }
        }, 4000);
    </script>
</body>
</html>
