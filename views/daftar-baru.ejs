<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Baru - Tatriz SystemB</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root { --biru-safir: #0f52ba; --biru-gelap: #082d66; --hijau: #2ecc71; --bg: #f0f4f8; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg); margin:0; padding:20px; min-height:100vh; }
        .container { max-width: 650px; margin: auto; }
        .card { background: white; border-radius: 20px; padding: 35px; box-shadow: 0 15px 35px rgba(0,0,0,0.08); margin-bottom:20px; display:none; border: 1px solid rgba(15,82,186,0.1); }
        .card.active { display:block; animation: fadeUp .4s ease; }
        @keyframes fadeUp { from { opacity:0; transform: translateY(20px);} to { opacity:1; transform: translateY(0);} }
        .step-badge { background: var(--biru-safir); color:white; padding:6px 14px; border-radius:20px; font-size:12px; font-weight:800; letter-spacing:1px; }
        h2 { color: var(--biru-gelap); margin:15px 0 8px; font-size:24px; }
        .sub { color:#636e72; font-size:14px; margin-bottom:25px; line-height:1.5; }
        label { display:block; font-size:11px; font-weight:800; color:var(--biru-gelap); text-transform:uppercase; letter-spacing:0.8px; margin-bottom:6px; }
        input, textarea { width:100%; padding:14px 15px; border:1px solid #ddd; border-radius:10px; font-size:15px; box-sizing:border-box; outline:none; transition:.3s; }
        input:focus, textarea:focus { border-color: var(--biru-safir); box-shadow:0 0 0 3px rgba(15,82,186,0.1); }
        .wa-box { display:flex; align-items:center; border:1px solid #ddd; border-radius:10px; overflow:hidden; background:#f8f9fa; }
        .wa-box span { padding:14px; font-weight:bold; color:#555; border-right:1px solid #ddd; background:#f0f0f0; }
        .wa-box input { border:none; border-radius:0; flex:1; }
        .btn { width:100%; padding:14px; border:none; border-radius:10px; font-weight:800; cursor:pointer; font-size:15px; letter-spacing:0.5px; transition:.3s; }
        .btn-primary { background: var(--biru-safir); color:white; }
        .btn-primary:hover { background: var(--biru-gelap); }
        .btn-green { background: var(--hijau); color:white; }
        .btn-outline { background:white; color:var(--biru-safir); border:2px solid var(--biru-safir); margin-top:10px; }
        .progress { display:flex; gap:8px; margin-bottom:25px; }
        .progress div { flex:1; height:6px; background:#e0e0e0; border-radius:10px; }
        .progress div.active { background: var(--hijau); }
        .keunggulan { display:grid; grid-template-columns:1fr 1fr 1fr; gap:15px; margin:20px 0; }
        .keunggulan div { background:#f8faff; padding:15px; border-radius:12px; text-align:center; border:1px solid #e3e8f0; }
        .keunggulan i { font-size:24px; color:var(--biru-safir); }
        .keunggulan p { font-size:12px; font-weight:700; margin:8px 0 0; color:var(--biru-gelap); }
        .input-error { border-color:#e74c3c !important; }
        small { font-size:11px; color:#e74c3c; margin-top:5px; display:block; }
    </style>
</head>
<body>
<div class="container">
    <!-- PROGRESS -->
    <div class="progress">
        <div id="p1" class="active"></div>
        <div id="p2"></div>
        <div id="p3"></div>
        <div id="p4"></div>
    </div>

    <!-- STEP 1: PENJELASAN -->
    <div class="card active" id="step1">
        <span class="step-badge">LANGKAH 1 DARI 4</span>
        <h2>Bordir Laku, Tapi Uangnya Kemana? 🤔</h2>
        <p class="sub">Tatriz SystemB udah dipakai 5 bulan di 2 cabang. Biar nggak rugi kayak dulu lagi, catatnya harus beres. Operator bisa di buatkan akun dan punya halaman sendiri untuk input data kerjaanya..!!</p>
        
        <div class="keunggulan">
            <div><i class="bi bi-search"></i><p>Tagihan Lama<br>Panggil Nama</p></div>
            <div><i class="bi bi-exclamation-triangle"></i><p>Kalau Kurang / lebih <br>Langsung Ketahuan</p></div>
            <div><i class="bi bi-receipt"></i><p>Centang Jadi<br>Nota WA</p></div>
            <div><i class="bi bi-cloud-upload"></i><p>Operator Absen / Input hasil<br>di HP sendiri</p></div>
        </div>

        <p class="sub" style="background:#fff3cd; padding:12px; border-radius:8px; border:1px dashed #f39c12; color:#7a5a00;">
            <i class="bi bi-lightbulb"></i> <b>Buat yang baru pertama kali:</b> Daftar di sini dulu, nanti admin aktifkan. Nggak perlu kode aktivasi, nggak ribet.
        </p>

        <button class="btn btn-primary" onclick="nextStep(2)"><i class="bi bi-arrow-right-circle"></i> LANJUT DAFTAR PERUSAHAAN</button>
        <button class="btn btn-outline" onclick="window.location='/'">Saya Sudah Punya Akun, Login</button>
    </div>

    <!-- STEP 2: USERNAME & PASSWORD -->
    <div class="card" id="step2">
        <span class="step-badge">LANGKAH 2 DARI 4 - BUAT AKUN LOGIN</span>
        <h2>Buat Akun Login Dulu 🔐</h2>
        <p class="sub">Ini yang nanti kamu pakai buat masuk ke aplikasi. Buat yang gampang diingat ya.</p>

        <div style="margin-bottom:15px;">
            <label>Username (buat login)</label>
            <input type="text" id="username" placeholder="Contoh: bordirberkah" required>
            <small id="err-user" style="display:none;">Username minimal 4 huruf, tanpa spasi</small>
        </div>
        <div style="margin-bottom:20px;">
            <label>Password</label>
            <div style="position:relative;">
                <input type="password" id="password" placeholder="Minimal 6 karakter" required>
                <i class="bi bi-eye" id="togglePass" style="position:absolute; right:15px; top:50%; transform:translateY(-50%); cursor:pointer; color:#999;"></i>
            </div>
            <small id="err-pass" style="display:none;">Password minimal 6 karakter</small>
        </div>

        <button class="btn btn-primary" onclick="validateStep2()">LANJUT ISI DATA TOKO <i class="bi bi-arrow-right"></i></button>
        <button class="btn btn-outline" onclick="nextStep(1)">Kembali</button>
    </div>

    <!-- STEP 3: DATA LENGKAP -->
    <div class="card" id="step3">
        <span class="step-badge">LANGKAH 3 DARI 4 - DATA TOKO</span>
        <h2>Data Toko Bordirmu 🏪</h2>
        <p class="sub">Biar nota dan tagihannya atas nama tokomu sendiri.</p>

        <div style="margin-bottom:15px;">
            <label>Nama Perusahaan / Toko *</label>
            <input type="text" id="nama_toko" placeholder="Contoh: Bordir Berkah Klaten" required>
            <small id="err-toko" style="display:none;">Wajib diisi</small>
        </div>
        <div style="margin-bottom:15px;">
            <label>Nomor WA Admin (untuk terima tagihan & aktivasi) *</label>
            <div class="wa-box">
                <span>+62</span>
                <input type="text" id="no_hp" placeholder="8131529xxxx" oninput="formatWA(this)" required>
            </div>
            <small style="color:#636e72; font-size:10px;">*Tulis tanpa 0 di depan. Contoh: 81315290003. Nomor ini yang dapat WA pengingat.</small>
            <small id="err-wa" style="display:none;">Wajib isi nomor WA</small>
        </div>
        <div style="margin-bottom:20px;">
            <label>Alamat Workshop (boleh kosong dulu)</label>
            <textarea id="alamat" rows="2" placeholder="Contoh: Sraten, Pedan, Klaten"></textarea>
        </div>

        <button class="btn btn-green" id="btnDaftar" onclick="submitDaftar()"><i class="bi bi-cloud-upload"></i> DAFTAR SEKARANG</button>
        <button class="btn btn-outline" onclick="nextStep(2)">Kembali</button>
    </div>

    <!-- STEP 4: SUCCESS + WA -->
    <div class="card" id="step4" style="text-align:center;">
        <div style="width:70px; height:70px; background:#e8f8f5; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 15px;">
            <i class="bi bi-check-circle-fill" style="font-size:40px; color:var(--hijau);"></i>
        </div>
        <h2>Berhasil Daftar! 🎉</h2>
        <p class="sub">Data tokomu sudah tersimpan sebagai <b>PENDING</b>. Sekarang kasih tau admin biar segera diaktifkan.</p>

        <div style="background:#f0f4f8; padding:15px; border-radius:10px; text-align:left; font-size:13px; margin-bottom:20px; border:1px dashed var(--biru-safir);">
            <b>Data yang tersimpan:</b><br>
            Toko: <span id="summary-toko">-</span><br>
            Username: <span id="summary-user">-</span><br>
            WA: +62<span id="summary-wa">-</span><br>
            Status: <span style="background:#f39c12; color:white; padding:2px 8px; border-radius:4px; font-size:11px;">MENUNGGU AKTIVASI</span>
        </div>

        <button class="btn btn-green" onclick="kirimWA()" style="font-size:18px; padding:18px;"><i class="bi bi-whatsapp"></i> KIRIM WA KE ADMIN UNTUK AKTIVASI</button>
        <p style="font-size:12px; color:#636e72; margin-top:15px;">Admin akan aktifkan akunmu, lalu kirim link login asli. Kamu tinggal login pakai username yang barusan kamu buat.</p>
    </div>
</div>

<script>
let formData = {};
function nextStep(n){
    document.querySelectorAll('.card').forEach(c=>c.classList.remove('active'));
    document.getElementById('step'+n).classList.add('active');
    document.querySelectorAll('.progress div').forEach((p,i)=>{ p.classList.toggle('active', i < n); });
    window.scrollTo(0,0);
}
function validateStep2(){
    let valid=true;
    const u=document.getElementById('username').value.trim();
    const p=document.getElementById('password').value.trim();
    if(u.length<4 || u.includes(' ')){ document.getElementById('username').classList.add('input-error'); document.getElementById('err-user').style.display='block'; valid=false; } else { document.getElementById('username').classList.remove('input-error'); document.getElementById('err-user').style.display='none'; }
    if(p.length<6){ document.getElementById('password').classList.add('input-error'); document.getElementById('err-pass').style.display='block'; valid=false; } else { document.getElementById('password').classList.remove('input-error'); document.getElementById('err-pass').style.display='none'; }
    if(!valid) return;
    formData.username=u; formData.password=p;
    nextStep(3);
}
function formatWA(input){
    let nomor=input.value.replace(/\D/g,'');
    if(nomor.startsWith('0')) nomor=nomor.substring(1);
    if(nomor.startsWith('62')) nomor=nomor.substring(2);
    input.value=nomor;
}
async function submitDaftar(){
    const nama_toko=document.getElementById('nama_toko').value.trim();
    const no_hp=document.getElementById('no_hp').value.trim();
    const alamat=document.getElementById('alamat').value.trim();
    let valid=true;
    if(!nama_toko){ document.getElementById('nama_toko').classList.add('input-error'); document.getElementById('err-toko').style.display='block'; valid=false; } else { document.getElementById('nama_toko').classList.remove('input-error'); document.getElementById('err-toko').style.display='none'; }
    if(!no_hp){ document.getElementById('no_hp').classList.add('input-error'); document.getElementById('err-wa').style.display='block'; valid=false; } else { document.getElementById('no_hp').classList.remove('input-error'); document.getElementById('err-wa').style.display='none'; }
    if(!valid) return;

    formData.nama_toko=nama_toko; formData.no_hp=no_hp; formData.alamat=alamat;

    const btn=document.getElementById('btnDaftar');
    btn.innerHTML='<i class="bi bi-hourglass-split"></i> MENYIMPAN...'; btn.disabled=true;

    try{
        const res=await fetch('/daftar-baru', {
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body: JSON.stringify(formData)
        });
        const data=await res.json();
        if(data.success){
            document.getElementById('summary-toko').innerText=formData.nama_toko;
            document.getElementById('summary-user').innerText=formData.username;
            document.getElementById('summary-wa').innerText=formData.no_hp;
            nextStep(4);
        } else {
            Swal.fire('Gagal', data.message || 'Gagal mendaftar', 'error');
            btn.innerHTML='<i class="bi bi-cloud-upload"></i> DAFTAR SEKARANG'; btn.disabled=false;
        }
    }catch(e){
        Swal.fire('Error', 'Tidak bisa terhubung ke server. Coba lagi.', 'error');
        btn.innerHTML='<i class="bi bi-cloud-upload"></i> DAFTAR SEKARANG'; btn.disabled=false;
    }
}
function kirimWA(){
    const pesan=`Halo Admin Tatriz, saya sudah mendaftar perusahaan *${formData.nama_toko}* \nUsername: *${formData.username}* \nWA: +62${formData.no_hp} \nMohon diaktifkan ya. Terima kasih.`;
    const noWA='6281315290003';
    window.open(`https://api.whatsapp.com/send/?phone=${noWA}&text=${encodeURIComponent(pesan)}`, '_blank');
}
document.getElementById('togglePass').addEventListener('click', function(){
    const input=document.getElementById('password');
    input.type = input.type==='password' ? 'text' : 'password';
    this.classList.toggle('bi-eye'); this.classList.toggle('bi-eye-slash');
});
</script>
</body>
</html>
